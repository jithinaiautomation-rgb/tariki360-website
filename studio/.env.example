# Copy this file to `.env` (in this studio/ folder) and fill in your project id.
#
# Sanity Studio only reads variables that start with SANITY_STUDIO_.
# This is separate from the website's .env one folder up — the website uses
# PUBLIC_SANITY_PROJECT_ID. Both need the same project id.
#
# Find it at https://www.sanity.io/manage — open your project and it's the
# short code shown on the dashboard and in the browser address bar,
# e.g. "a1b2c3d4".

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
