---
/**
 * The home page, in one language.
 *
 * Both /  and /ar/ render this file — they just pass a different `lang`.
 * Everything here is plain Astro, so it becomes static HTML at build time.
 * The only JavaScript on this page is the FAQ accordion and the sign-up
 * modal, both of which are React islands that load lazily.
 */
import { Image } from 'astro:assets';

import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Btn from '~/components/Btn.astro';
import Tag from '~/components/Tag.astro';
import Chip from '~/components/Chip.astro';
import Feat from '~/components/Feat.astro';
import Reveal from '~/components/Reveal.astro';
import FAQ from '~/components/react/FAQ.tsx';

import heroImg from '~/assets/images/hero.png';
import problemImg from '~/assets/images/problem.jpg';
import studentImg from '~/assets/images/student.png';
import ctaImgEn from '~/assets/images/course-detail.png';
import ctaImgAr from '~/assets/images/course-detail-ar.png';

import { localePath, absoluteUrl, type Lang } from '~/lib/i18n';
import { HOME } from '~/content/home';
import { pageCopy } from '~/lib/pageCopy';
import { fetchSanity } from '~/lib/sanity';
import {
  TESTIMONIALS_QUERY,
  VIDEO_TESTIMONIALS_QUERY,
  HOME_VIDEO_QUERY,
} from '~/lib/queries';
import { getSiteSettings } from '~/lib/settings';
import { organizationSchema, webSiteSchema } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Page wording comes from the 'pageIndex' document in Sanity, laid over the
// built-in copy in src/content/home.ts. See src/lib/pageCopy.ts.
const t = await pageCopy('pageIndex', lang, HOME[lang]);
const rtl = lang === 'ar';

/* ---- Content from Sanity, fetched at build time -------------------------- */

const testimonials = await fetchSanity(
  TESTIMONIALS_QUERY,
  { lang },
  t.fallbackTestimonials,
);

type VideoTestimonial = {
  name: string;
  role: string;
  videoUrl?: string | null;
  fileUrl?: string | null;
  thumbUrl?: string | null;
};

const videoTestimonialsRaw = await fetchSanity<VideoTestimonial[]>(
  VIDEO_TESTIMONIALS_QUERY,
  { lang },
  t.fallbackVideoTestimonials as VideoTestimonial[],
);
const videoTestimonials = videoTestimonialsRaw.map((v) => ({
  ...v,
  videoUrl: v.fileUrl || v.videoUrl || null,
}));

const homeVideoRaw = await fetchSanity<any>(HOME_VIDEO_QUERY, {}, t.fallbackHomeVideo);
const homeVideo = {
  ...t.fallbackHomeVideo,
  ...homeVideoRaw,
  videoUrl: homeVideoRaw?.fileUrl || homeVideoRaw?.videoUrl || null,
};

/* ---- Structured data ----------------------------------------------------- */

const settings = await getSiteSettings();
const siteUrl = absoluteUrl('/', Astro.site);
const logoUrl = absoluteUrl('/logo.png', Astro.site);

const schemas = [
  organizationSchema({
    name: settings.siteName,
    legalName: settings.organisationLegalName,
    url: siteUrl,
    logo: logoUrl,
    socialLinks: settings.socialLinks,
  }),
  webSiteSchema({
    name: settings.siteName,
    url: siteUrl,
    description: settings.defaultDescription,
    lang,
  }),
];

const ctaImg = rtl ? ctaImgAr : ctaImgEn;
---

<Base
  lang={lang}
  path=""
  title={t.metaTitle}
  description={t.metaDescription}
  seoTitle={t.seo?.title}
  seoDescription={t.seo?.description}
  seoImage={t.seo?.image}
  schemas={schemas}>
  {/* ================================================================ Hero */}
  <section class="vhero">
    <div class="vhero-deco">
      <div class="vhero-blob" style="width:600px;height:600px;top:-250px;right:-120px"></div>
      <div class="vhero-blob2" style="width:280px;height:280px;bottom:-60px;left:160px"></div>
    </div>

    <div class="vc">
      <div class="g2" style="gap:48px;align-items:center">
        <div class="vhero-content" style="min-width:0">
          <Reveal>
            <Tag color="dark" icon="auto_awesome">{t.heroTag}</Tag>
          </Reveal>
          <Reveal delay={100}>
            {/* The one and only <h1> on this page. */}
            <h1>
              {t.heroTitleA}<br />{t.heroTitleLead}{' '}
              <span class="vhero-hl">{t.heroTitleHl}</span>
            </h1>
          </Reveal>
          <Reveal delay={200}>
            <p class="vhero-sub">{t.heroSub}</p>
          </Reveal>
          <Reveal delay={300}>
            <div class="vhero-cta">
              <Btn variant="lime" size="lg" opensSignup>{t.startMapping}</Btn>
              <Btn variant="outline" size="lg" href={localePath(lang, 'services')}>
                {t.seeSample}
              </Btn>
            </div>
          </Reveal>
          <Reveal delay={400}>
            <div class="vhero-feats">
              {
                t.heroFeats.map(([icon, label]) => (
                  <div class="vhero-feat">
                    <Icon name={icon} size={19} color="#85131D" />
                    {label}
                  </div>
                ))
              }
            </div>
          </Reveal>
        </div>

        <Reveal delay={250} class="hero-img-wrap">
          <div class="hero-ring"></div>
          <div class="hero-img-card">
            {/*
              Astro converts this to WebP and writes width/height into the
              HTML, so the layout doesn't shift while it loads.
              It's the largest image above the fold, so it loads eagerly.
            */}
            <Image
              src={heroImg}
              alt={t.heroTitleA}
              widths={[500, 1000]}
              sizes="(max-width: 900px) 0px, 500px"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="hchip hchip-a">
            <Icon name="workspace_premium" size={22} color="#85131D" />
            <span>{t.hchipA}<small>{t.hchipASub}</small></span>
          </div>
          <div class="hchip hchip-b">
            <Icon name="play_circle" size={22} color="#85131D" />
            <span>{t.hchipB}<small>{t.hchipBSub}</small></span>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ========================================================== Stats bar */}
  <div class="vstatbar">
    <div class="vstatbar-inner">
      {
        t.stats.map(([num, label], i) => (
          <Reveal delay={i * 110} class="vstat-pop" style="text-align:center">
            <div class="vstat-num">{num}</div>
            <div class="vstat-lbl">{label}</div>
          </Reveal>
        ))
      }
    </div>
  </div>

  {/* =========================================================== Marquee */}
  <div class="vmarquee" aria-hidden="true">
    <div class="vmarquee-track">
      {
        [...t.quotes, ...t.quotes].map((q) => (
          <div class="vmarquee-item">
            <span class="vmarquee-q">"</span>{q}<span class="vmarquee-q">"</span>
          </div>
        ))
      }
    </div>
  </div>

  {/* =========================================================== Problem */}
  <section class="vsec" style="background:#fff;padding:80px 0">
    <div class="vc">
      <div class="g2" style="gap:72px;align-items:center">
        <div>
          <Reveal>
            <Tag color="green">{t.problemTag}</Tag>
            <h2
              style="font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;font-size:clamp(28px,5vw,36px);line-height:1.22;color:var(--c-dark);margin:20px 0 20px;letter-spacing:-0.02em;text-wrap:pretty">
              {t.problemTitle}
            </h2>
            <p style="font-size:17px;line-height:1.7;color:var(--c-muted);margin:0 0 40px;text-wrap:pretty">
              {t.problemBody}
            </p>
          </Reveal>

          <div style="display:flex;flex-direction:column;gap:16px">
            <Reveal delay={120}>
              <div style="display:flex;align-items:flex-start;gap:16px;background:rgba(133,19,29,0.05);border:1.5px solid rgba(133,19,29,0.12);border-radius:16px;padding:18px 22px">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(133,19,29,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <Icon name="warning" size={22} color="#85131D" />
                </div>
                <p style="margin:0;font-size:15px;line-height:1.6;color:var(--c-dark);font-weight:500">
                  <span style="color:#85131D;font-weight:700">{t.insight1Pct}</span>{' '}
                  {t.insight1Text}
                </p>
              </div>
            </Reveal>

            <Reveal delay={240}>
              <div style="display:flex;align-items:flex-start;gap:16px;background:rgba(12,77,28,0.05);border:1.5px solid rgba(12,77,28,0.12);border-radius:16px;padding:18px 22px">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(12,77,28,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  <Icon name="psychology_alt" size={22} color="var(--c-green)" />
                </div>
                <p style="margin:0;font-size:15px;line-height:1.6;color:var(--c-dark);font-weight:500">
                  {t.insight2Lead}{' '}
                  <span style="color:var(--c-green);font-weight:700">{t.insight2Hl}</span>{' '}
                  {t.insight2Trail}
                </p>
              </div>
            </Reveal>
          </div>
        </div>

        <Reveal delay={150}>
          <div style="display:flex;align-items:center;justify-content:center;min-width:0">
            <Image
              src={problemImg}
              alt={t.problemImgAlt}
              widths={[560, 1120]}
              sizes="(max-width: 900px) 100vw, 560px"
              format="webp"
              quality={80}
              class="tilt-img"
              style="width:100%;max-width:560px;height:auto;display:block;border-radius:20px;box-shadow:0 8px 40px rgba(7,24,16,0.10)"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ================================================ Students & Parents */}
  <section class="vsec vsec-light">
    <div class="vc">
      <Reveal>
        <div class="vsec-head">
          <Tag color="green">{t.featuresTag}</Tag>
          <h2 class="vh2" style="margin-top:16px;margin-bottom:12px">{t.featuresTitle}</h2>
          <p style="font-size:18px;color:var(--c-muted);max-width:520px;margin:0">
            {t.featuresSub}
          </p>
        </div>
      </Reveal>

      <div class="g2">
        <Reveal delay={100}>
          <div class="vcard vcard-ltop vcard-hover" style="height:100%">
            <div style="display:flex;align-items:center;gap:14px;margin-bottom:28px">
              <Chip icon="school" color="lime" />
              <div>
                <div class="vlbl" style="color:var(--c-muted);margin-bottom:3px">
                  {t.forStudentsLbl}
                </div>
                <div class="vh4" style="margin:0">{t.discoverDna}</div>
              </div>
            </div>
            <div class="g2" style="gap:18px">
              {t.feats.map(([icon, title, desc]) => <Feat icon={icon} title={title} desc={desc} />)}
            </div>
          </div>
        </Reveal>

        <Reveal delay={220}>
          <div class="vcard vcard-prem vcard-hover" style="height:100%">
            <Chip icon="family_restroom" color="dark" />
            <h3 style="font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:700;font-size:30px;margin:20px 0 12px;color:#fff">
              {t.forParentsTitle}
            </h3>
            <p style="color:rgba(255,255,255,0.75);margin:0 0 30px;line-height:1.65;font-size:17px">
              {t.forParentsBody}
            </p>
            <ul style="list-style:none;padding:0;margin:0 0 36px;display:flex;flex-direction:column;gap:16px">
              {
                t.forParentsList.map((item) => (
                  <li style="display:flex;align-items:center;gap:12px">
                    <Icon name="check" size={22} color="var(--c-lime)" />
                    <span style="color:rgba(255,255,255,0.9);font-size:16px">{item}</span>
                  </li>
                ))
              }
            </ul>
            <div style="margin-top:auto;display:flex;flex-direction:column;gap:16px">
              <Btn variant="lime" icon="arrow_forward" opensSignup>{t.startMapping}</Btn>
              <span class="vtag vtag-dark">{t.trustedBy}</span>
            </div>
          </div>
        </Reveal>
      </div>

      {/* ---- For Schools, full width ---- */}
      <Reveal delay={120}>
        <div class="vcard vcard-ltop" style="margin-top:24px">
          <div class="g2" style="gap:48px;align-items:center">
            <div>
              <Chip icon="account_balance" color="lime" />
              <h3 class="vh3" style="margin:18px 0 12px">{t.forSchoolsTitle}</h3>
              <p style="color:var(--c-muted);line-height:1.65;margin:0 0 26px;font-size:17px">
                {t.forSchoolsBody}
              </p>
              <Btn variant="lime" icon="arrow_forward" href={localePath(lang, 'contact')}>
                {t.bookSchoolDemo}
              </Btn>
            </div>
            <div style="display:flex;flex-direction:column;gap:14px">
              {
                t.schoolFeatures.map(([icon, title, desc]) => (
                  <div style="display:flex;align-items:center;gap:16px;background:var(--c-surf-2);border-radius:14px;padding:16px 20px">
                    <Chip icon={icon} color="green" />
                    <div>
                      <div style="font-weight:600;font-size:15px">{title}</div>
                      <div style="font-size:13px;color:var(--c-muted)">{desc}</div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {/* ===================================================== Product video */}
  <section class="vsec" style="background:#F5EDD8;padding:56px 0 48px;overflow:hidden">
    <div class="vc">
      <Reveal>
        <div style="text-align:center;margin-bottom:24px">
          <h2 style="font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:800;font-size:clamp(28px,5.5vw,40px);line-height:1.2;color:var(--c-dark);margin:16px 0 0;letter-spacing:-0.02em">
            {homeVideo.sectionHeading}
          </h2>
        </div>
      </Reveal>

      <div class="g2 vvideo-grid" style="gap:40px;align-items:stretch">
        <Reveal
          delay={120}
          style={`position:relative;display:flex;flex-direction:column${rtl ? ';order:2' : ''}`}>
          <div style="border-radius:20px;overflow:hidden;box-shadow:0 24px 64px rgba(7,24,16,0.18),0 4px 16px rgba(7,24,16,0.08);border:1px solid rgba(7,24,16,0.1);display:flex;flex-direction:column;flex:1">
            {/* Browser chrome */}
            <div style="background:#0c4d1c;padding:12px 18px;display:flex;align-items:center;gap:12px">
              <div style="display:flex;gap:7px">
                {
                  ['#ff5f57', '#febc2e', '#28c840'].map((c) => (
                    <div style={`width:12px;height:12px;border-radius:50%;background:${c}`} />
                  ))
                }
              </div>
              <div style="flex:1;background:rgba(255,255,255,0.12);border-radius:6px;padding:5px 12px;font-size:12px;color:rgba(255,255,255,0.6);font-family:Inter,sans-serif;text-align:center">
                {t.appUrlLabel}
              </div>
            </div>

            {/* Video area */}
            <div style="background:linear-gradient(145deg,#071810 0%,#0c2e18 60%,#0f3d20 100%);position:relative;flex:1;min-height:340px;display:flex;align-items:center;justify-content:center;overflow:hidden">
              {
                homeVideo.videoUrl ? (
                  <video
                    controls
                    preload="none"
                    poster={homeVideo.posterUrl || undefined}
                    src={homeVideo.videoUrl}
                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
                  />
                ) : (
                  <>
                    <div style="position:absolute;inset:0;opacity:0.06;background-image:linear-gradient(rgba(157,227,20,0.4) 1px,transparent 1px),linear-gradient(90deg,rgba(157,227,20,0.4) 1px,transparent 1px);background-size:40px 40px" />
                    <div style="position:absolute;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(133,19,29,0.25) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%)" />

                    <div style="position:absolute;top:18px;left:18px;background:rgba(255,255,255,0.07);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:10px 16px;display:flex;align-items:center;gap:8px">
                      <div style="width:8px;height:8px;border-radius:50%;background:#9de314;box-shadow:0 0 6px #9de314" />
                      <span style="color:#fff;font-size:12px;font-weight:600;font-family:Inter,sans-serif">
                        {homeVideo.badgeLabel}
                      </span>
                    </div>

                    <div style="position:absolute;top:18px;right:18px;background:rgba(133,19,29,0.5);border:1px solid rgba(133,19,29,0.6);border-radius:8px;padding:6px 12px">
                      <span style="color:#fff;font-size:11px;font-weight:700;font-family:Inter,sans-serif;letter-spacing:0.06em">
                        ● LIVE
                      </span>
                    </div>

                    <div style="position:relative;z-index:2;text-align:center">
                      <div class="vplay" style="width:72px;height:72px;border-radius:50%;background:#85131D;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
                        <Icon name="play_arrow" size={36} color="#fff" />
                      </div>
                      <div style="color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:18px">
                        {homeVideo.captionTitle}
                      </div>
                      <div style="color:rgba(255,255,255,0.55);font-size:13px;margin-top:6px;font-family:Inter,sans-serif">
                        {homeVideo.captionSubtitle}
                      </div>
                    </div>

                    <div style="position:absolute;bottom:48px;left:0;right:0;display:flex;justify-content:center;gap:10px">
                      {
                        (homeVideo.careerTags || []).map((ct: string, i: number) => (
                          <div
                            style={`background:${i === 0 ? 'rgba(133,19,29,0.7)' : 'rgba(255,255,255,0.08)'};border:1px solid ${i === 0 ? 'rgba(133,19,29,0.9)' : 'rgba(255,255,255,0.15)'};border-radius:999px;padding:5px 14px;color:#fff;font-size:12px;font-weight:600;font-family:Inter,sans-serif`}>
                            {ct}
                          </div>
                        ))
                      }
                    </div>

                    <div style="position:absolute;bottom:0;left:0;right:0">
                      <div style="height:3px;background:rgba(255,255,255,0.1)">
                        <div style="width:38%;height:100%;background:#85131D" />
                      </div>
                      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 14px;background:rgba(0,0,0,0.35)">
                        <div style="display:flex;gap:14px;align-items:center">
                          <Icon name="play_arrow" size={18} color="#fff" />
                          <Icon name="volume_up" size={16} color="rgba(255,255,255,0.6)" />
                          <span style="color:rgba(255,255,255,0.55);font-size:11px;font-family:Inter,sans-serif">
                            1:24 / 3:45
                          </span>
                        </div>
                        <div style="display:flex;gap:14px">
                          <Icon name="closed_caption" size={16} color="rgba(255,255,255,0.6)" />
                          <Icon name="fullscreen" size={16} color="rgba(255,255,255,0.6)" />
                        </div>
                      </div>
                    </div>
                  </>
                )
              }
            </div>

            {/* Label strip */}
            <div style="background:#fff;padding:16px 20px;display:flex;align-items:center;justify-content:space-between">
              <div style="display:flex;align-items:center;gap:12px">
                <div style="width:36px;height:36px;border-radius:10px;background:var(--c-lime-dim);display:flex;align-items:center;justify-content:center">
                  <Icon name="smart_toy" size={18} color="#85131D" />
                </div>
                <div>
                  <div style="font-weight:700;font-size:13px;color:var(--c-dark);font-family:'Plus Jakarta Sans',sans-serif">
                    {t.aiCounsellorTitle}
                  </div>
                  <div style="font-size:11px;color:var(--c-muted)">{t.aiCounsellorSub}</div>
                </div>
              </div>
              <span class="vtag vtag-green" style="font-size:10px">{t.instantAccess}</span>
            </div>
          </div>
        </Reveal>

        <Reveal delay={260} class="vvideo-char" style={rtl ? 'order:1' : undefined}>
          <div style="display:flex;align-items:flex-end;justify-content:center;overflow:visible;height:100%">
            <Image
              src={studentImg}
              alt={t.studentImgAlt}
              widths={[520, 1040]}
              sizes="(max-width: 900px) 0px, 520px"
              format="webp"
              quality={80}
              style="width:100%;max-height:560px;object-fit:contain;object-position:left bottom;display:block;mix-blend-mode:multiply;transform:translateX(-40px);transform-origin:bottom left"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ======================================================= How it works */}
  <section class="vsec" style="background:#335a33">
    <div class="vc">
      <Reveal>
        <div class="vsec-head ctr">
          <Tag color="green">{t.journeyTag}</Tag>
          <h2 class="vh2" style="color:#fff;margin-top:16px;margin-bottom:0">{t.journeyTitle}</h2>
        </div>
      </Reveal>
      <div class="vsteps">
        {
          t.journey.map((s, i) => (
            <Reveal delay={i * 130}>
              <div class="vstep">
                <div class="vstep-bubble">
                  <Icon name={s.n} size={34} color="var(--c-dark)" />
                  <div class="vstep-num">{s.num}</div>
                </div>
                <h3 style="color:#fff;margin:0 0 8px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:600;font-size:19px">
                  {s.t}
                </h3>
                <p style="color:rgba(255,255,255,0.6);font-size:14px;margin:0;line-height:1.55">
                  {s.d}
                </p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ============================================================ Report */}
  <section class="vsec" style="background:#F5EDD8">
    <div class="vc g2" style="align-items:flex-start;gap:64px">
      <Reveal>
        <div>
          <Tag color="dark">{t.reportTag}</Tag>
          <h2 class="vh2" style="color:var(--c-green);margin-top:20px;margin-bottom:18px">
            {t.reportTitle}
          </h2>
          <p style="color:var(--c-muted);font-size:17px;line-height:1.65;margin:0 0 32px">
            {t.reportBody}
          </p>
          <div style="display:flex;flex-direction:column;gap:10px">
            {
              t.reportItems.map(([icon, label]) => (
                <div style="display:flex;align-items:center;gap:14px;padding:13px 18px;border-radius:12px;background:#fff;border:1px solid rgba(51,90,50,0.12)">
                  <div style="width:40px;height:40px;border-radius:10px;background:rgba(51,90,50,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <Icon name={icon} size={22} color="var(--c-green)" />
                  </div>
                  <span style="color:var(--c-dark);font-weight:600;font-size:15px">{label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </Reveal>

      <Reveal delay={180}>
        <div style="background:#fff;border:1px solid rgba(51,90,50,0.12);border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:14px;flex:1;box-shadow:0 4px 20px rgba(51,90,50,0.08)">
          <div style="background:var(--c-tint);border-radius:14px;padding:20px;border:1px solid rgba(51,90,50,0.1)">
            <div class="vlbl" style="color:var(--c-green);margin-bottom:12px">
              {t.careerDnaProfile}
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              {t.careerDnaTags.map((tag) => <span class="vtag vtag-green">{tag}</span>)}
            </div>
          </div>

          <div style="background:var(--c-tint);border-radius:14px;padding:20px;border:1px solid rgba(51,90,50,0.1)">
            <div class="vlbl" style="color:var(--c-green);margin-bottom:14px">
              {t.topCareerMatches}
            </div>
            {
              t.topCareerList.map(([name, pct]) => (
                <div style="margin-bottom:12px">
                  <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--c-dark);margin-bottom:5px;font-weight:500">
                    <span>{name}</span>
                    <span style="color:var(--c-red);font-weight:700">{pct}</span>
                  </div>
                  <div style="height:5px;border-radius:3px;background:rgba(51,90,50,0.12)">
                    <div
                      class="vbarfill"
                      style={`--w:${pct};height:100%;background:var(--c-green);border-radius:3px`}
                    />
                  </div>
                </div>
              ))
            }
          </div>

          <div style="background:var(--c-tint);border-radius:14px;padding:20px;border:1px solid rgba(51,90,50,0.1)">
            <div class="vlbl" style="color:var(--c-green);margin-bottom:14px">
              {t.strengthBreakdown}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              {
                t.strengthList.map(([name, value]) => (
                  <div style="text-align:center;background:#fff;border-radius:10px;padding:12px;border:1px solid rgba(51,90,50,0.1)">
                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:28px;color:var(--c-green)">
                      {value}
                    </div>
                    <div style="font-size:12px;color:var(--c-muted);margin-top:4px">{name}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {/* =============================================== School counselor suite */}
  <section class="vsec vsec-mid">
    <div class="vc">
      <Reveal>
        <div style="background:rgba(255,255,255,0.55);border-radius:32px;padding:8px">
          <div class="vcard" style="border-radius:26px;padding:48px">
            <div class="g2" style="gap:56px;align-items:stretch">
              <div>
                <Tag color="green">{t.counselorSuiteTag}</Tag>
                <h2 class="vh2" style="margin-top:16px;margin-bottom:32px;font-size:36px">
                  {t.counselorSuiteTitle}
                </h2>
                <div style="display:flex;flex-direction:column;gap:10px">
                  <div style="background:var(--c-lime-dim);border:1.5px solid rgba(157,227,20,0.35);border-radius:12px;padding:18px 20px">
                    <div class="vlbl" style="color:var(--c-green);margin-bottom:5px">
                      {t.studentAnalytics}
                    </div>
                    <div style="font-size:14px;color:var(--c-muted)">{t.studentAnalyticsSub}</div>
                  </div>
                  {
                    t.counselorSuiteItems.map((item) => (
                      <div style="background:var(--c-surf-2);border-radius:12px;padding:18px 20px;border:1.5px solid transparent">
                        <div class="vlbl" style="color:var(--c-muted)">{item}</div>
                      </div>
                    ))
                  }
                </div>
                <a
                  href={localePath(lang, 'contact')}
                  style="display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;font-size:16px;color:var(--c-green);padding:0;margin-top:40px">
                  <span style="border-bottom:2px solid var(--c-lime);padding-bottom:3px">
                    {t.requestPartnerDemo}
                  </span>
                  <Icon name="arrow_forward" size={22} />
                </a>
              </div>

              <Reveal delay={150}>
                <div style="background:var(--c-surf);border-radius:18px;padding:24px;border:1.5px solid var(--c-border);height:100%">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:16px">
                      {t.cohortOverview}
                    </div>
                    <span class="vtag vtag-lime">{t.liveTag}</span>
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:24px">
                    {
                      t.cohortStats.map(([num, label]) => (
                        <div style="background:#fff;border-radius:12px;padding:14px;text-align:center;border:1.5px solid var(--c-border)">
                          <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:24px;color:var(--c-green)">
                            {num}
                          </div>
                          <div style="font-size:11px;color:var(--c-muted);margin-top:3px">{label}</div>
                        </div>
                      ))
                    }
                  </div>
                  <div style="font-size:13px;font-weight:600;color:var(--c-muted);margin-bottom:12px">
                    {t.careerInterestDist}
                  </div>
                  {
                    t.careerInterestList.map(([name, value]) => (
                      <div style="margin-bottom:10px">
                        <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px">
                          <span style="color:var(--c-dark);font-weight:500">{name}</span>
                          <span style="color:var(--c-green);font-weight:700">{value}</span>
                        </div>
                        <div style="height:6px;border-radius:3px;background:var(--c-border)">
                          <div
                            class="vbarfill"
                            style={`--w:${value};height:100%;background:var(--c-lime);border-radius:3px`}
                          />
                        </div>
                      </div>
                    ))
                  }
                </div>
              </Reveal>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  {/* ==================================================== Success stories */}
  <section class="vsec vsec-light">
    <div class="vc">
      <Reveal>
        <div class="vsec-head ctr" style="max-width:620px;margin:0 auto 56px">
          <Tag color="lime" icon="favorite">{t.successTag}</Tag>
          <h2 class="vh2" style="margin-top:16px;margin-bottom:12px">{t.successTitle}</h2>
          <p style="color:var(--c-muted);margin:0;font-size:17px">{t.successSub}</p>
        </div>
      </Reveal>

      <div class="g3" style="margin-bottom:48px">
        {
          testimonials.map((tm, i) => (
            <Reveal delay={i * 130}>
              <figure class="vcard vcard-hover" style="display:flex;flex-direction:column;height:100%;margin:0">
                <Icon name="format_quote" size={32} color="var(--c-lime)" />
                <blockquote style="color:var(--c-muted);font-size:14px;line-height:1.65;flex:1;margin:12px 0 20px;padding:0;border:none;font-style:normal">
                  {tm.quote}
                </blockquote>
                <figcaption style="display:flex;align-items:center;gap:12px">
                  <div style="width:44px;height:44px;border-radius:50%;background:var(--c-lime-dim);border:2px solid rgba(157,227,20,.3);display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:var(--c-green);flex-shrink:0">
                    {tm.initials}
                  </div>
                  <div>
                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:var(--c-dark)">
                      {tm.name}
                    </div>
                    <div style="font-size:12px;color:var(--c-muted)">{tm.role}</div>
                  </div>
                </figcaption>
              </figure>
            </Reveal>
          ))
        }
      </div>

      <Reveal>
        <h3 class="vh4" style="margin-bottom:20px">{t.videoTestimonialsTitle}</h3>
      </Reveal>
      <div class="g3">
        {
          videoTestimonials.map((v, i) => (
            <Reveal delay={i * 130}>
              <div class="vcard vcard-hover vthumb" style="padding:0;overflow:hidden;border-radius:16px">
                <a
                  href={v.videoUrl || undefined}
                  target={v.videoUrl ? '_blank' : undefined}
                  rel={v.videoUrl ? 'noopener noreferrer' : undefined}
                  aria-label={v.videoUrl ? `${v.name} — ${v.role}` : undefined}
                  style={`height:180px;display:flex;align-items:center;justify-content:center;position:relative;background:${
                    v.thumbUrl
                      ? `url(${v.thumbUrl}) center/cover`
                      : 'linear-gradient(135deg,var(--c-dark) 0%,rgba(52,92,51,.8) 100%)'
                  };cursor:${v.videoUrl ? 'pointer' : 'default'};pointer-events:${
                    v.videoUrl ? 'auto' : 'none'
                  }`}>
                  <div
                    class="vplaymini"
                    style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center">
                    <Icon name="play_arrow" size={30} color="#fff" />
                  </div>
                </a>
                <div style="padding:16px 18px">
                  <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:var(--c-dark)">
                    {v.name}
                  </div>
                  <div style="font-size:12px;color:var(--c-muted)">{v.role}</div>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* =============================================================== FAQ */}
  <section class="vsec vsec-light">
    <div class="vc" style="max-width:760px">
      <Reveal>
        <div class="vsec-head ctr">
          <Tag color="green">{t.faqTag}</Tag>
          <h2 class="vh2" style="margin-top:16px;margin-bottom:0">{t.faqTitle}</h2>
        </div>
      </Reveal>
      <Reveal delay={120}>
        {/*
          `client:visible` — React for the accordion is fetched only once the
          FAQ scrolls into view, so it costs nothing on first paint.
        */}
        <FAQ items={t.faqs} client:visible />
      </Reveal>
    </div>
  </section>

  {/* ======================================================== Bottom CTA */}
  <section class="vsec" style="background:#F5EDD8">
    <div class="vc">
      <Reveal>
        <div class="cta-banner">
          <div>
            <h2 class="vh2" style="color:var(--c-green);margin:0 0 16px">{t.ctaTitle}</h2>
            <p style="font-size:18px;color:var(--c-muted);max-width:540px;margin:0 0 40px;line-height:1.6">
              {t.ctaBody}
            </p>
            <div style="display:flex;gap:16px;flex-wrap:wrap">
              <Btn variant="lime" size="lg" opensSignup>{t.ctaStart}</Btn>
              <Btn variant="outline" size="lg" href={localePath(lang, 'contact')}>
                {t.ctaSchoolDemo}
              </Btn>
            </div>
          </div>
          <div class="cta-banner-img">
            <Image
              src={ctaImg}
              alt={t.ctaImgAlt}
              widths={[400, 800]}
              sizes="(max-width: 900px) 60vw, 400px"
              format="webp"
              quality={80}
              style="mix-blend-mode:multiply"
            />
          </div>
        </div>
      </Reveal>
    </div>
  </section>
</Base>
