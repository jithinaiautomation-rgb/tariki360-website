---
/** Services page, in one language. Rendered at /services/ and /ar/services/. */
import { Image } from 'astro:assets';

import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Btn from '~/components/Btn.astro';
import Tag from '~/components/Tag.astro';
import Chip from '~/components/Chip.astro';
import Reveal from '~/components/Reveal.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';

import ctaImgEn from '~/assets/images/course-detail.png';
import ctaImgAr from '~/assets/images/course-detail-ar.png';

import { localePath, absoluteUrl, type Lang } from '~/lib/i18n';
import { SERVICES } from '~/content/services';
import { pageCopy } from '~/lib/pageCopy';
import { HOME } from '~/content/home';
import { COMMON } from '~/content/site';
import { fetchSanity } from '~/lib/sanity';
import { TESTIMONIALS_QUERY, VIDEO_TESTIMONIALS_QUERY } from '~/lib/queries';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Page wording comes from the 'pageServices' document in Sanity, laid over
// the built-in copy. See src/lib/pageCopy.ts.
const t = await pageCopy('pageServices', lang, SERVICES[lang]);
const common = COMMON[lang];

/* Testimonials are shared with the home page, so they come from the same
   Sanity documents rather than being duplicated in code. */
const testimonials = await fetchSanity(
  TESTIMONIALS_QUERY,
  { lang },
  HOME[lang].fallbackTestimonials,
);
const videoTestimonials = await fetchSanity<any[]>(
  VIDEO_TESTIMONIALS_QUERY,
  { lang },
  HOME[lang].fallbackVideoTestimonials as any[],
);

const crumbs = [
  { name: common.breadcrumbHome, href: localePath(lang) },
  { name: t.metaTitle },
];

const schemas = [
  breadcrumbSchema([
    { name: common.breadcrumbHome, url: absoluteUrl(localePath(lang), Astro.site) },
    {
      name: t.metaTitle,
      url: absoluteUrl(localePath(lang, 'services'), Astro.site),
    },
  ]),
];

const characterImg = lang === 'ar' ? ctaImgAr : ctaImgEn;
---

<Base
  lang={lang}
  path="services"
  title={t.metaTitle}
  description={t.metaDescription}
  seoTitle={t.seo?.title}
  seoDescription={t.seo?.description}
  seoImage={t.seo?.image}
  structuredData={t.structuredData}
  schemas={schemas}>
  {/* ---- Hero ---- */}
  <section
    class="vsec"
    style="padding:48px 0 24px;background:#F5EDD8;position:relative;overflow:hidden">
    <div
      style="position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(45deg,rgba(12,77,28,0.06) 0px,rgba(12,77,28,0.06) 1px,transparent 1px,transparent 24px);opacity:0.8">
    </div>
    <div
      style="position:absolute;top:-100px;left:-100px;width:300px;height:300px;border-radius:50%;border:50px solid rgba(12,77,28,0.06);pointer-events:none">
    </div>
    <div
      style="position:absolute;top:-60px;left:-60px;width:180px;height:180px;border-radius:50%;border:30px solid rgba(12,77,28,0.04);pointer-events:none">
    </div>
    <div
      style="position:absolute;bottom:-90px;right:-90px;width:280px;height:280px;border-radius:50%;border:44px solid rgba(133,19,29,0.07);pointer-events:none">
    </div>
    <div
      style="position:absolute;top:10%;right:8%;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(157,227,20,0.10) 0%,transparent 70%);pointer-events:none">
    </div>

    <div class="vc" style="max-width:820px;margin:0 auto;position:relative;z-index:1">
      <Breadcrumbs items={crumbs} style="justify-content:center;margin-bottom:20px" />
      <div style="text-align:center">
        <Reveal>
          <h1
            class="vh2"
            style="color:var(--c-green);margin-top:20px;margin-bottom:18px;font-size:clamp(28px,7vw,54px)">
            {t.heroTitle}
          </h1>
          <p style="color:var(--c-muted);font-size:18px;max-width:560px;margin:0 auto 36px;line-height:1.65">
            {t.heroSubtitle}
          </p>
        </Reveal>
        <Reveal delay={140}>
          <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
            <Btn variant="lime" size="lg" opensSignup>{t.forStudents}</Btn>
            <Btn variant="outline" size="lg" href="#institutions">{t.forInstitutionsBtn}</Btn>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ---- Tier cards ---- */}
  <section class="vsec vsec-light" style="padding-top:24px">
    <div class="vc">
      <Reveal>
        <div style="text-align:center;margin-bottom:4px">
          <Image
            src={characterImg}
            alt={t.characterImgAlt}
            widths={[300, 600]}
            sizes="(max-width: 600px) 60vw, 300px"
            format="webp"
            quality={80}
            style="width:auto;max-width:100%;height:clamp(180px,38vw,300px);display:inline-block;mix-blend-mode:multiply;filter:drop-shadow(0 8px 24px rgba(7,24,16,0.10))"
          />
        </div>
      </Reveal>

      <div class="g2">
        {/* Tier 1 */}
        <Reveal delay={100} style="display:flex">
          <div class="vcard vcard-ltop" style="gap:0;flex:1">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px">
              <div>
                <div class="vlbl" style="color:var(--c-muted);margin-bottom:8px">{t.tier1Label}</div>
                <h2 class="vh3">{t.tier1Title}</h2>
              </div>
              <Chip icon="bolt" color="lime" />
            </div>
            <p style="color:var(--c-muted);margin-bottom:16px;line-height:1.65">{t.tier1Desc}</p>
            <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:24px;padding:14px 18px;background:var(--c-tint);border-radius:12px;border:1px solid rgba(51,90,50,0.12)">
              <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:var(--c-green);line-height:1">
                {t.tier1Price}
              </span>
              <span style="font-size:13px;color:var(--c-muted);font-weight:500">{t.oneTime}</span>
            </div>
            <ul class="vtiers">
              {
                t.tier1.map(([, label]) => (
                  <li>
                    <Icon name="check_circle" size={20} color="var(--c-lime)" />
                    {label}
                  </li>
                ))
              }
            </ul>
            <div style="display:flex;gap:14px;margin-top:auto">
              <Btn variant="lime" opensSignup>{t.getStarted}</Btn>
              <Btn variant="outline" icon="arrow_forward" href={localePath(lang, 'benefits')}>
                {t.viewProcess}
              </Btn>
            </div>
          </div>
        </Reveal>

        {/* Tier 2 — premium */}
        <Reveal delay={220} style="display:flex">
          <div class="vcard vcard-prem" style="flex:1">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px">
              <div>
                <div class="vlbl" style="color:rgba(255,255,255,0.45);margin-bottom:8px">
                  {t.tier2Label}
                </div>
                <h2 class="vh3" style="color:#fff">{t.tier2Title}</h2>
              </div>
              <div
                class="vchip"
                style="background:var(--c-gold);width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center">
                <Icon name="workspace_premium" color="var(--c-dark)" />
              </div>
            </div>
            <p style="color:rgba(255,255,255,0.62);margin-bottom:16px;line-height:1.65">
              {t.tier2Desc}
            </p>
            <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:24px;padding:14px 18px;background:rgba(232,152,32,0.12);border-radius:12px;border:1px solid rgba(232,152,32,0.25)">
              <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:36px;color:var(--c-gold);line-height:1">
                {t.tier2Price}
              </span>
              <span style="font-size:13px;color:rgba(255,255,255,0.5);font-weight:500">
                {t.oneTime}
              </span>
            </div>
            <div style="background:rgba(232,152,32,0.1);border:1px solid rgba(232,152,32,0.2);border-radius:14px;padding:20px 22px;margin-bottom:24px">
              <div class="vlbl" style="color:var(--c-gold);margin-bottom:14px">
                {t.premiumBenefits}
              </div>
              <ul class="vtiers" style="margin-bottom:0">
                {
                  t.tier2.map(([, label]) => (
                    <li>
                      <Icon name="check_circle" size={20} color="var(--c-gold)" />
                      <span style="color:rgba(255,255,255,0.9)">{label}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div style="display:flex;gap:14px;margin-top:auto">
              <Btn variant="lime" opensSignup>{t.getStarted}</Btn>
              <Btn variant="ghost" icon="arrow_forward" href={localePath(lang, 'benefits')}>
                {t.viewProcess}
              </Btn>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ---- Institutional ---- */}
  <section class="vsec vsec-mid" id="institutions">
    <div class="vc">
      <Reveal>
        <div class="vsec-head ctr" style="max-width:620px;margin:0 auto 56px">
          <Tag color="green">{t.instTag}</Tag>
          <h2 class="vh2" style="margin-top:16px;margin-bottom:12px">{t.instTitle}</h2>
          <p style="color:var(--c-muted);margin:0;font-size:17px">{t.instSubtitle}</p>
        </div>
      </Reveal>
      <div class="g3" style="margin-bottom:40px">
        {
          t.inst.map(([icon, title, desc], i) => (
            <Reveal delay={i * 130} style="display:flex">
              <div class="vcard vcard-hover vcard-ltop" style="flex:1">
                <Chip icon={icon} color="lime" />
                <h3 class="vh4" style="margin:18px 0 8px">{title}</h3>
                <p style="color:var(--c-muted);font-size:14px;margin:0;line-height:1.55">{desc}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
      <Reveal delay={120}>
        <div style="text-align:center">
          <Btn variant="lime" size="lg" href={localePath(lang, 'contact')}>{t.requestDemo}</Btn>
        </div>
      </Reveal>
    </div>
  </section>

  {/* ---- Success stories ---- */}
  <section class="vsec vsec-light">
    <div class="vc">
      <Reveal>
        <div class="vsec-head ctr" style="max-width:620px;margin:0 auto 56px">
          <Tag color="lime" icon="favorite">{t.successTag}</Tag>
          <h2 class="vh2" style="margin-top:16px;margin-bottom:12px">{t.successTitle}</h2>
          <p style="color:var(--c-muted);margin:0;font-size:17px">{t.successSubtitle}</p>
        </div>
      </Reveal>

      <div class="g3" style="margin-bottom:48px">
        {
          testimonials.map((ts, i) => (
            <Reveal delay={i * 130}>
              <figure
                class="vcard vcard-hover"
                style="display:flex;flex-direction:column;height:100%;margin:0">
                <Icon name="format_quote" size={32} color="var(--c-lime)" />
                <blockquote style="color:var(--c-muted);font-size:14px;line-height:1.65;flex:1;margin:12px 0 20px;padding:0;border:none;font-style:normal">
                  {ts.quote}
                </blockquote>
                <figcaption style="display:flex;align-items:center;gap:12px">
                  <div style="width:44px;height:44px;border-radius:50%;background:var(--c-lime-dim);border:2px solid rgba(157,227,20,.3);display:flex;align-items:center;justify-content:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:var(--c-green);flex-shrink:0">
                    {ts.initials}
                  </div>
                  <div>
                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:var(--c-dark)">
                      {ts.name}
                    </div>
                    <div style="font-size:12px;color:var(--c-muted)">{ts.role}</div>
                  </div>
                </figcaption>
              </figure>
            </Reveal>
          ))
        }
      </div>

      <Reveal>
        <h3 class="vh4" style="margin-bottom:20px">{t.videoTestimonialsTitle}</h3>
      </Reveal>
      <div class="g3">
        {
          videoTestimonials.map((v, i) => {
            const href = v.fileUrl || v.videoUrl || null;
            return (
              <Reveal delay={i * 130}>
                <div class="vcard vcard-hover vthumb" style="padding:0;overflow:hidden;border-radius:16px">
                  <a
                    href={href || undefined}
                    target={href ? '_blank' : undefined}
                    rel={href ? 'noopener noreferrer' : undefined}
                    aria-label={href ? v.name + ' — ' + v.role : undefined}
                    style={`height:180px;display:flex;align-items:center;justify-content:center;position:relative;background:${
                      v.thumbUrl
                        ? 'url(' + v.thumbUrl + ') center/cover'
                        : 'linear-gradient(135deg,var(--c-dark) 0%,rgba(52,92,51,.8) 100%)'
                    };pointer-events:${href ? 'auto' : 'none'}`}>
                    <div
                      class="vplaymini"
                      style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.4);display:flex;align-items:center;justify-content:center">
                      <Icon name="play_arrow" size={30} color="#fff" />
                    </div>
                  </a>
                  <div style="padding:16px 18px">
                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:14px;color:var(--c-dark)">
                      {v.name}
                    </div>
                    <div style="font-size:12px;color:var(--c-muted)">{v.role}</div>
                  </div>
                </div>
              </Reveal>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
