# Copy this file to `.env` and fill in the values.
# Everything prefixed PUBLIC_ is readable at build time by Astro.

# ---- Sanity ----------------------------------------------------------------
# Find these at https://www.sanity.io/manage → click your project.
# The project ID is the short code in the URL and on the project dashboard,
# e.g. "a1b2c3d4". The dataset is almost always "production".
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ---- Site ------------------------------------------------------------------
# The final public URL, with no trailing slash. Used for canonical URLs,
# sitemap.xml, robots.txt and the Open Graph / Twitter share tags.
# Set this to your real domain before going live.
PUBLIC_SITE_URL=https://www.tariki360.ae
